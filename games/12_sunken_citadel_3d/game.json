  "id": "12_sunken_citadel_3d",
  "title": "Sunken Citadel",
  "genre": "3D action arena combat",
  "orientation": 0,
  "startScene": "Main",
  "scenes": [
    "Main"
  ],
  "networking": false,
  "ai_assist": false,
  "scripts": [
    "Knight.js",
    "Citadel.js",
    "Hollow.js",
    "Revenant.js",
