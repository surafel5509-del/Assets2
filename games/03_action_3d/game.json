{
  "id": "03_action_3d",
  "title": "Hollow Ridge",
  "genre": "3D Action-Adventure",
  "orientation": 0,
  "startScene": "Main",
  "scenes": [
    "Main"
  ],
  "networking": false,
  "ai_assist": false,
  "scripts": [
    "ThirdPersonCamera.js",
    "CharacterController3D.js",
    "EnemyAI3D.js",
    "InteractionSystem.js",
    "Combat3D.js",
    "LightingRig.js",
    "AdventureHUD.js"
  ],
  "controls": {
    "move": "left joystick, camera-relative",
    "look": "right-side drag orbits the camera",
    "attack": "action button A",
    "interact": "action button B (context prompt)",
    "jump": "swipe up on the left joystick"
  },
  "systems": [
    "camera-relative movement: input is rotated by the camera yaw so 'up' always means away from the camera",
    "orbit camera with collision pull-in, pitch clamps and target smoothing",
    "character controller with gravity, ground snapping, coyote time and jump buffering",
    "enemy AI: patrol spline, hearing radius, line-of-sight raycast, pursuit and attack",
    "environmental interaction: levers, chests and a day/night light rig",
    "3D combat with a spherical sweep and stagger windows"
  ],
  "engineNotes": {
    "models": "MeshRenderer loads .obj (AssetKind.MODEL = [\"obj\"]).  Every Kenney Nature Kit model ships in DAE/FBX/GLTF/OBJ/STL; this game references the OBJ path and the store reports the rest in altFormats.",
    "characters": "The Nature Kit has no rigged characters, so characters are billboarded sprites over 3D geometry -- a documented trade-off, not a missing asset.  The hero uses the FreeCharactersAnimationsAssetPack 96x96 sheets (all grid-verified).  The Memao 384x1968 sheet was tried first and rejected: two of its columns have sprites bleeding across row boundaries, so it has no admissible uniform grid and the store correctly declines to guess one.",
    "shadows": "Dynamic lighting uses the engine's directional Light plus a projected blob shadow sprite, because cascaded shadow maps belong to the Vulkan backend (see docs/02-graphics.md), not the GLES2 runtime this scene runs on today."
  },
