{
  "id": "01_topdown_rpg",
  "title": "Emberfall - A Top-Down Adventure",
  "genre": "2D Top-Down RPG / Adventure",
  "orientation": 0,
  "startScene": "Main",
  "scenes": [
    "Main"
  ],
  "networking": false,
  "ai_assist": false,
  "scripts": [
    "GameManager.js",
    "PlayerController.js",
    "EnemyAI.js",
    "Combat.js",
    "InventoryUI.js",
    "NpcDialogue.js",
    "TilemapBuilder.js"
  ],
  "controls": {
    "move": "virtual joystick (8-direction)",
    "attack": "action button A",
    "interact": "action button B",
    "inventory": "tap the bag icon / keyboard I"
  },
  "systems": [
    "8-direction movement on a 4-direction sprite sheet (see README: sprite directions)",
    "tilemap built at runtime from a tileset atlas + a byte-coded map",
    "finite-state enemy AI: patrol / chase / attack / hurt / die",
    "melee combat with directional arcs, invulnerability frames and knockback",
    "inventory + equipment HUD driven by the imported icon set",
    "dialogue system with branching NPC pages"
  ],
  "spriteDirections": {
    "note": "blonde_man.png is 32x32 in a 4x8 grid. Rows 0-3 are the walk cycle for down/left/right/up (col 0 and col 3 are the same stance frame). Rows 4-7 repeat those four directions as a 2-frame action cycle. Verified by hashing all 32 cells: 20 are unique and (0,0)==(0,3)==(4,0)==(4,2).",
    "walkRows": {
      "down": 0,
      "left": 1,
      "right": 2,
      "up": 3
    },
    "actionRows": {
      "down": 4,
      "left": 5,
      "right": 6,
      "up": 7
    }
  },
