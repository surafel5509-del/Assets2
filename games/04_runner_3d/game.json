{
  "id": "04_runner_3d",
  "title": "Neon Overdrive",
  "genre": "3D Endless Runner / Racer",
  "orientation": 1,
  "startScene": "Main",
  "scenes": [
    "Main"
  ],
  "networking": false,
  "ai_assist": false,
  "scripts": [
    "TrackGenerator.js",
    "VehicleController.js",
    "ObstacleSpawner.js",
    "PickupSystem.js",
    "RacerHUD.js",
    "CameraRig.js",
    "MenuFlow.js"
  ],
  "controls": {
    "steer": "left joystick X, or drag left/right",
    "jump": "action button A",
    "drift/nitro": "hold action button B",
    "pause": "on-screen button"
  },
  "systems": [
    "procedural track: a fixed-size pool of segments recycled as the vehicle passes them",
    "lane-free continuous steering with clamped lateral velocity",
    "obstacle spawning weighted by distance so difficulty ramps without a level file",
    "pickup collection with a combo window and a nitro meter fed by pickups",
    "speed-based camera FOV kick and motion streaks"
  ],
  "engineNotes": {
    "pooling": "Nothing is spawned at runtime except pickups and obstacles, and even those come from pre-placed prototype objects that are deactivated rather than destroyed.  Per-frame allocation is what causes the periodic hitch that ruins a runner.",
    "track": "The track is 14 recycled segments of 24 units.  Total live geometry stays constant regardless of distance travelled, so memory is flat over an infinite run.",
    "determinism": "Obstacle layout uses a seeded PRNG so a run can be reproduced from its seed, which is what makes a leaderboard honest without any server."
  },
